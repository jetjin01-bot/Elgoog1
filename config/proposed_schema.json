    },
    "PARTY_TO_CONTRACT": {
      "source": "organisation",
      "target": "document",
      "description": "Associates an organisation with a contract or agreement as a stated party."
    },
    "CONTAINS_CONTRACTUAL_TERM": {
      "source": "document",
      "target": "contractual_term",
      "description": "Associates a contract with one of its contractual terms."
    },
    "APPLIES_TO_PARTY": {
      "source": "contractual_term",
