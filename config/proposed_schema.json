    "HAS_TECHNICAL_PARAMETER": {
      "source": "product_or_equipment",
      "target": "technical_parameter",
      "description": "Associates equipment or a product with a stated technical parameter."
    },
    "HAS_SECTION": {
      "source": "document",
      "target": "document",
